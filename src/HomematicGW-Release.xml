  <op:config href="HomematicGW.conf.xml" />

  <!-- TODO migrate to regular namespace! -->
  <op:ETS
          OpenKnxId="0xAC"
          ApplicationNumber="0x50"
          ApplicationVersion="0.3.0"
          ReplacesVersions="0.2 0.1 0.0"
          ApplicationRevision="0"
          ProductName="Homematic GW"
          BusCurrent="30"
          OrderNumber="CK-HomeMatic-GW" />

  <op:define prefix="BASE" ModuleType="10" share="../lib/OGM-Common/src/Common.share.xml">
