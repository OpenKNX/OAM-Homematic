  </op:define>

  <op:define prefix="NET" ModuleType="11" share="../lib/OFM-Network/src/Network.share.xml">
    <op:verify File="../lib/OFM-Network/library.json" ModuleVersion="%NET_VerifyVersion%" />
  </op:define>

  <op:define prefix="UCT" ModuleType="19" share="../lib/OFM-ConfigTransfer/src/ConfigTransfer.share.xml">
    <op:verify File="../lib/OFM-ConfigTransfer/library.json" ModuleVersion="%UCT_VerifyVersion%" />
  </op:define>

  <op:define prefix="HMG" ModuleType="23"
             share=   "../lib/OFM-Homematic/src/HomematicModule.share.xml"
             template="../lib/OFM-Homematic/src/HomematicModule.templ.xml"
             NumChannels="32"
             KoSingleOffset="20"
             KoOffset="60">
    <op:verify File="../lib/OFM-Homematic/library.json" ModuleVersion="%HMG_VerifyVersion%" />
